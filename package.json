{
  "name": "illuminable-room-modeler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "server:api": "node server/api/start.js",
    "migrate": "node server/db/migrate.js",
    "debug:github-upload": "node server/graphDatabase/debugGithubUpload.mjs",
